---
// Sticky section nav for the landing pages. Lives here rather than in each
// page so the three languages cannot drift apart again: the markup, the
// scroll-spy and the scroll affordances are defined once.
interface Props {
  links: { href: string; label: string }[];
  label?: string;
}
const { links, label = "Sections" } = Astro.props;
---

<nav class="section-nav" aria-label={label}>
  <div class="section-nav-pill">
    <div class="section-nav-inner">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
  </div>
</nav>

  <script is:inline>
    // Scroll-spy: highlight the section nav link for whatever section is in view.
    // The nav renders above the sections it tracks, so this cannot run inline:
    // at that point getElementById finds nothing and the scroll-spy gives up.
    function initSectionNav() {
      var nav = document.querySelector(".section-nav");
      if (!nav) return;
      var links = Array.prototype.slice.call(
        nav.querySelectorAll('a[href^="#"]'),
      );
      var sections = links
        .map(function (a) {
          return document.getElementById(a.getAttribute("href").slice(1));
        })
        .filter(Boolean);
      if (!sections.length) return;
      var scroller = document.querySelector(".section-nav-inner");

      // Bring the highlighted link into view, centred. On a phone the pill is
      // narrower than its links, so the highlight is useless once the current
      // section has scrolled out of it; centring also makes the resting
      // position say where you are in the run of sections.
      function reveal(link) {
        if (!scroller || !link) return;
        if (scroller.scrollWidth <= scroller.clientWidth) return;
        var l = link.getBoundingClientRect();
        var s = scroller.getBoundingClientRect();
        var delta = l.left + l.width / 2 - (s.left + s.width / 2);
        if (Math.abs(delta) < 1) return;
        scroller.scrollTo({
          left: scroller.scrollLeft + delta,
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "auto"
            : "smooth",
        });
      }

      var current = null;
      function setCurrent(id) {
        if (id === current) return;
        current = id;
        var active = null;
        links.forEach(function (a) {
          var on = a.getAttribute("href") === "#" + id;
          a.setAttribute("aria-current", on ? "true" : "false");
          if (on) active = a;
        });
        reveal(active);
      }
      // Flag which way the pill can still scroll, so each chevron only shows
      // while there is something that way (see .can-scroll-left/right).
      if (scroller) {
        var edges = function () {
          var max = scroller.scrollWidth - scroller.clientWidth;
          nav.classList.toggle("can-scroll-left", scroller.scrollLeft > 1);
          nav.classList.toggle(
            "can-scroll-right",
            scroller.scrollLeft < max - 1,
          );
        };
        scroller.addEventListener("scroll", edges, { passive: true });
        addEventListener("resize", edges);
        edges();
      }

      // The current section is the last one whose top has passed the line just
      // under the pinned nav. Reading whatever sits mid-viewport instead gets
      // short sections wrong: jumping to an anchor puts the target at the top,
      // so for Toolbox the middle of the screen is already Experience.
      var LINE = 90;
      var queued = false;
      function pick() {
        queued = false;
        var last = sections[sections.length - 1];
        // the final section may be too short to ever reach the line
        if (
          innerHeight + scrollY >=
          document.documentElement.scrollHeight - 2
        ) {
          return setCurrent(last.id);
        }
        var best = sections[0];
        sections.forEach(function (s) {
          if (s.getBoundingClientRect().top <= LINE) best = s;
        });
        setCurrent(best.id);
      }
      function onScroll() {
        if (queued) return;
        queued = true;
        requestAnimationFrame(pick);
      }
      addEventListener("scroll", onScroll, { passive: true });
      addEventListener("resize", onScroll);
      pick();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initSectionNav);
    } else {
      initSectionNav();
    }
  </script>
