---
// Background for the footer: the gamma density the hero's rug was drawn
// from, standing on the legal bar's border as its axis, with the same rug
// along it. The sample lives in src/lib/gamma.ts.
import { HI, LO, density, draws, toX } from "../lib/gamma";

const r2 = (n: number) => n.toFixed(2);

// The viewBox is stretched to the footer (preserveAspectRatio="none"), so the
// units are arbitrary: y has the axis at 100 and the peak at 18. Strokes are
// non-scaling, so the stretch does not thicken them.
const W = 100,
  H = 100,
  PEAK = 82;
const Y = (v: number) => H - PEAK * density(v);

const G = 200;
const curve = Array.from({ length: G }, (_, i) => {
  const v = LO + ((HI - LO) * i) / (G - 1);
  return `${r2(toX(v, W))},${r2(Y(v))}`;
});
const line = `M${curve.join(" L")}`;
const area = `${line} L${W},${H} L0,${H} Z`;

const rug = draws.map((v) => `M${r2(toX(v, W))},${H} V${H - 5}`).join(" ");
---

<svg
  class="foot-motif"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path class="m-area" d={area}></path>
  <path class="m-curve" d={line}></path>
  <path class="m-rug" d={rug}></path>
</svg>
