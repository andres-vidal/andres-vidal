---
// Background for the footer: a gamma density with a rug of draws from it
// along the axis. The draws come from a fixed seed, so the picture is
// the same on every build; the blog asks its figures to be reproducible, and
// the decoration gets held to the same rule.
function mulberry32(seed: number) {
  let a = seed;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(20261013);
const r2 = (n: number) => n.toFixed(2);

// The viewBox is stretched to the footer (preserveAspectRatio="none"), so the
// units are arbitrary: y has the axis at 100 and the peak at 18. Strokes are
// non-scaling, so the stretch does not thicken them. Shape 3 puts the mode at
// 2, away from the edge, with the long tail running under the links; the
// density is scaled to a peak of 1, and a draw is the sum of three unit
// exponentials.
const W = 100,
  H = 100,
  PEAK = 82,
  K = 3,
  LO = 0,
  HI = 9;
const f = (v: number) => (v / (K - 1)) ** (K - 1) * Math.exp(K - 1 - v);
const exp1 = () => -Math.log(1 - rand());
const draw = () => Array.from({ length: K }, exp1).reduce((s, e) => s + e, 0);
const X = (v: number) => ((v - LO) / (HI - LO)) * W;
const Y = (v: number) => H - PEAK * f(v);

const G = 200;
const curve = Array.from({ length: G }, (_, i) => {
  const v = LO + ((HI - LO) * i) / (G - 1);
  return `${r2(X(v))},${r2(Y(v))}`;
});
const line = `M${curve.join(" L")}`;
const area = `${line} L${W},${H} L0,${H} Z`;

const draws = Array.from({ length: 160 }, draw).filter((v) => v > LO && v < HI);
const rug = draws.map((v) => `M${r2(X(v))},${H} V${H - 5}`).join(" ");
---

<svg
  class="foot-motif"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path class="m-area" d={area}></path>
  <path class="m-curve" d={line}></path>
  <path class="m-rug" d={rug}></path>
</svg>
