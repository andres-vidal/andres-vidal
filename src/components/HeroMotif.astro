---
// Background for the hero: the logistic curve, as one faint ochre line across
// the full width of the window, standing on the hero's lower edge. It is the
// logistic regression link and distribution function on one side, and the
// classic neural-network activation on the other. It sits flat under the name
// and climbs in the open space to the right.
const r2 = (n: number) => n.toFixed(2);

// Stretched to the hero (preserveAspectRatio="none"), so the units are
// arbitrary: y has the axis at 100 and the top of the curve at 28. The input
// runs over [-7, 3], which puts the midpoint at 70% of the width. Strokes are
// non-scaling.
const W = 100,
  H = 100,
  PEAK = 72,
  LO = -7,
  HI = 3,
  G = 240;
const line =
  "M" +
  Array.from({ length: G }, (_, i) => {
    const t = LO + ((HI - LO) * i) / (G - 1);
    const x = (i / (G - 1)) * W;
    return `${r2(x)},${r2(H - PEAK / (1 + Math.exp(-t)))}`;
  }).join(" L");
---

<svg
  class="hero-motif"
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path d={line}></path>
</svg>
